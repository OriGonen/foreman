#!/bin/bash
# ralph — a loop that implements one ticket per iteration, in whatever repository you are
# standing in. The toolkit is installed once per machine and holds no state of its own;
# everything that differs between batches lives in the batch directory.
#
#   ralph init    <batch> [--force] [--no-order]   scaffold a batch, then order it
#   ralph order   <batch>                have an agent (re-)order the tickets
#   ralph status  [batch]                what is left, what is next            (free)
#   ralph dry-run [batch]                the plan and the exact prompt         (free)
#   ralph run     [batch] [<n>|--unlimited] [--live] [--adopt-dirty]  one iteration by default
#   ralph next    [batch] [--list|--count|--all|--unordered]  the run order    (free)
#   ralph report  [batch] [--by-ticket|--failures] what it cost               (free)
#   ralph doctor  [--fix]                is this repo (and this machine) ready (free)
#   ralph help | ralph version
#
# <batch> is any directory in the current repository holding tickets and a ralph.conf.
# It may be omitted when exactly one directory in the repo has one.
#
# Everything after the subcommand is passed through untouched, so the environment still
# wins over a batch's ralph.conf:
#
#   RALPH_MAX_COST_USD=25 ralph run .scratch/my-batch
#
# See $RALPH_HOME/README.md for the whole picture.
set -uo pipefail

# The directory above this script's, from the shell: `dirname` would be a process, and `${x%/*}`
# alone is wrong for a bare name and for a file in `/`.
#
# ralph.cmd hands bash a Windows path (C:\...\bin\ralph), which has no '/' to strip, so
# backslashes are turned into slashes first; otherwise this resolves against the cwd.
_self="${BASH_SOURCE[0]//\\//}"
RALPH_HOME="${_self%/*}"; [ "$RALPH_HOME" != "$_self" ] || RALPH_HOME=.
RALPH_HOME="$(cd "${RALPH_HOME:-/}/.." && pwd)"
export RALPH_HOME

# How the messages below the dispatcher should tell the user to invoke us. Exported so
# that ralph-config.sh and everything it feeds can name the command rather than a path.
export RALPH_INVOKE="${RALPH_INVOKE:-ralph}"

LIB="$RALPH_HOME/lib"

# The header comment above IS the help text: lines 2-23, with the leading '# ' stripped
# and $RALPH_HOME expanded so the README reference is a path you can actually open.
usage() {
  awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}" |
    sed "s|\$RALPH_HOME|$RALPH_HOME|g"
}

version() {
  local rev
  rev="$(git -C "$RALPH_HOME" rev-parse --short HEAD 2>/dev/null)" || rev="unknown"
  printf 'ralph %s\n%s\n' "$rev" "$RALPH_HOME"
}

# Splitting the batch argument out from the flags is what lets `ralph status --help` and
# `ralph run .scratch/b 5` both work while the loop keeps its own single-argument shape.
cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  init)      exec bash "$LIB/ralph-init.sh" "$@" ;;
  order)     exec bash "$LIB/ralph-order.sh" "$@" ;;
  run)       exec bash "$LIB/ralph-loop.sh" "$@" ;;
  status)    exec bash "$LIB/ralph-loop.sh" "$@" --status ;;
  dry-run)   exec bash "$LIB/ralph-loop.sh" "$@" --dry-run ;;
  next)      exec bash "$LIB/ralph-next.sh" "$@" ;;
  report)    exec node "$LIB/ralph-report.cjs" "$@" ;;
  doctor)    exec bash "$LIB/ralph-doctor.sh" "$@" ;;
  help|--help|-h)        usage; exit 0 ;;
  version|--version|-V)  version; exit 0 ;;
  '')        usage; exit 1 ;;
  *)
    printf 'ralph: unknown command '\''%s'\''\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
