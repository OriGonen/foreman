#!/bin/bash
# foreman — a loop that implements one ticket per iteration, in whatever repository you are
# standing in. The toolkit is installed once per machine and holds no state of its own;
# everything that differs between batches lives in the batch directory.
#
#   foreman init    <batch> [--force] [--no-order] [--no-commands]   scaffold, fill in, order
#   foreman order   <batch>                have an agent (re-)order the tickets
#   foreman commands <batch>               have an agent fill in foreman.conf's check/test commands
#   foreman status  [batch]                what is left, what is next            (free)
#   foreman dry-run [batch]                the plan and the exact prompt         (free)
#   foreman run     [batch] [<n>|--unlimited] [--live] [--adopt-dirty]  one iteration by default
#   foreman next    [batch] [--list|--count|--all|--unordered]  the run order    (free)
#   foreman report  [batch] [--by-ticket|--failures] what it cost               (free)
#   foreman doctor  [--fix]                is this repo (and this machine) ready (free)
#   foreman convert [<project>] [--dry-run]  move a project from ralph to foreman
#   foreman help | foreman version
#
# <batch> is any directory in the current repository holding tickets and a foreman.conf.
# It may be omitted when exactly one directory in the repo has one.
#
# Everything after the subcommand is passed through untouched, so the environment still
# wins over a batch's foreman.conf:
#
#   FOREMAN_MAX_COST_USD=25 foreman run .scratch/my-batch
#
# See $FOREMAN_HOME/README.md for the whole picture.
set -uo pipefail

# The directory above this script's, from the shell: `dirname` would be a process, and `${x%/*}`
# alone is wrong for a bare name and for a file in `/`.
#
# foreman.cmd hands bash a Windows path (C:\...\bin\foreman), which has no '/' to strip, so
# backslashes are turned into slashes first; otherwise this resolves against the cwd.
_self="${BASH_SOURCE[0]//\\//}"
FOREMAN_HOME="${_self%/*}"; [ "$FOREMAN_HOME" != "$_self" ] || FOREMAN_HOME=.
FOREMAN_HOME="$(cd "${FOREMAN_HOME:-/}/.." && pwd)"
export FOREMAN_HOME

# How the messages below the dispatcher should tell the user to invoke us. Exported so
# that foreman-config.sh and everything it feeds can name the command rather than a path.
export FOREMAN_INVOKE="${FOREMAN_INVOKE:-foreman}"

LIB="$FOREMAN_HOME/lib"

# The header comment above IS the help text: lines 2-25, with the leading '# ' stripped
# and $FOREMAN_HOME expanded so the README reference is a path you can actually open.
usage() {
  awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}" |
    sed "s|\$FOREMAN_HOME|$FOREMAN_HOME|g"
}

# The sunrise drawn above the help on a terminal that can show it: foreman-ui.sh says whether the
# show is wanted and how wide the terminal is, and lib/foreman-draw.cjs draws it. The width it
# needs is the renderer's own for the `help` scene (a smoke case holds the two together); it is
# here so a narrow terminal is plain without starting node. Asking for help is the only thing
# that draws it, not the usage printed after a mistyped command.
#
# On a terminal — stdin and stdout both, so there is a key to skip with and a cursor to move —
# and not in CI (even when FOREMAN_SHOW=always forces the picture), the sunrise is first played as
# the intro (FOREMAN_INTRO=0 turns that off). Its last frame is the sunrise, left on the screen,
# and the help text goes on below it. The intro needs a little more width than the sunrise
# (`intro` in the renderer; a smoke case holds that too), and the renderer may decline to play
# (exit 4), when the plain sunrise is drawn instead. Ctrl-C during it ends the command.
_help_min_cols=64
_intro_min_cols=66
usage_show() {
  local tier cols status
  # shellcheck source=../lib/foreman-ui.sh
  source "$LIB/foreman-ui.sh" || return 0
  ui_show 1 tier && ui_cols cols 1 && [ "$cols" -ge "$_help_min_cols" ] || return 0
  if [ -t 0 ] && [ -t 1 ] && [ -z "${CI:-}" ] && [ "${FOREMAN_INTRO:-1}" != 0 ] && [ "$cols" -ge "$_intro_min_cols" ]; then
    node "$LIB/foreman-draw.cjs" intro --tier "$tier" --cols "$cols" --play 2>/dev/null
    status=$?
    # The renderer shows the cursor itself on every way out; this is for the way it cannot be
    # trusted to have taken (killed, or never started), and costs nothing.
    printf '\033[?25h'
    case "$status" in
      0) return 0 ;;
      130) exit 130 ;;
    esac
  fi
  node "$LIB/foreman-draw.cjs" help --tier "$tier" --cols "$cols" </dev/null 2>/dev/null || true
}

# `foreman version` at a terminal is the mark beside the build, drawn by the renderer (the `version`
# scene, which needs `_version_min_cols`; a smoke case holds the two together). Anywhere else it is
# the two lines it always was, and so it is if the renderer cannot draw: nothing is written
# before it has drawn the whole picture. The install path is told whole; the picture shortens it.
_version_min_cols=72
version() {
  local rev tier cols
  rev="$(git -C "$FOREMAN_HOME" rev-parse --short HEAD 2>/dev/null)" || rev="unknown"
  # shellcheck source=../lib/foreman-ui.sh
  if source "$LIB/foreman-ui.sh" && ui_show 1 tier && ui_cols cols 1 && [ "$cols" -ge "$_version_min_cols" ] &&
    printf 'rev\t%s\npath\t%s\nhome\t%s\n' "$rev" "$FOREMAN_HOME" "${HOME:-}" |
      node "$LIB/foreman-draw.cjs" version --tier "$tier" --cols "$cols" 2>/dev/null; then
    return 0
  fi
  printf 'foreman %s\n%s\n' "$rev" "$FOREMAN_HOME"
}

# `foreman report` at a terminal is the bill and the ledger, drawn by foreman-report.cjs with the
# renderer (the `report` scene, which needs `_report_min_cols`; a smoke case holds the two together).
# The report is node's all the way through, so this only says whether the picture is wanted and how
# to draw it, in the two variables it reads; anywhere else they are cleared, so a stray one in the
# environment cannot draw into a pipe, and it prints the text it always has.
_report_min_cols=84
report() {
  local tier cols
  # shellcheck source=../lib/foreman-ui.sh
  if source "$LIB/foreman-ui.sh" && ui_show 1 tier && ui_cols cols 1 && [ "$cols" -ge "$_report_min_cols" ]; then
    export FOREMAN_DRAW_TIER="$tier" FOREMAN_DRAW_COLS="$cols"
  else
    unset FOREMAN_DRAW_TIER FOREMAN_DRAW_COLS
  fi
  exec node "$LIB/foreman-report.cjs" "$@"
}

# Splitting the batch argument out from the flags is what lets `foreman status --help` and
# `foreman run .scratch/b 5` both work while the loop keeps its own single-argument shape.
cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  init)      exec bash "$LIB/foreman-init.sh" "$@" ;;
  order)     exec bash "$LIB/foreman-order.sh" "$@" ;;
  commands)  exec bash "$LIB/foreman-commands.sh" "$@" ;;
  run)       exec bash "$LIB/foreman-loop.sh" "$@" ;;
  status)    exec bash "$LIB/foreman-loop.sh" "$@" --status ;;
  dry-run)   exec bash "$LIB/foreman-loop.sh" "$@" --dry-run ;;
  next)      exec bash "$LIB/foreman-next.sh" "$@" ;;
  report)    report "$@" ;;
  doctor)    exec bash "$LIB/foreman-doctor.sh" "$@" ;;
  convert)   exec node "$LIB/foreman-convert.cjs" "$@" ;;
  help|--help|-h)        usage_show; usage; exit 0 ;;
  version|--version|-V)  version; exit 0 ;;
  '')        usage; exit 1 ;;
  *)
    printf 'foreman: unknown command '\''%s'\''\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
